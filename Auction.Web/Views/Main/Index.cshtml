@model OrdersAndItemsViewModel
@{
    ViewData["Title"] = "Аукционы";
}
<div class="parallax">
    <div class="container py-5">
        <div class="text-center mb-5 floating">
            <h1 class="display-4 fw-bold text-white mb-3">Добро пожаловать на аукцион выдуманных предметов!</h1>
            <p class="lead text-white-50 mb-4">Здесь вы можете купить/продать свой игровой предмет с помощью лотов</p>
            <div class="glass-card p-4 rounded-4 mb-4">
                <h2 class="text-white mb-0">Активные Лоты</h2>
            </div>
        </div>

        <div class="card glass-card p-4 rounded-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="glass-card">
                        <tr>
                            <th class="text-white fw-bold">Лот №</th>
                            <th class="text-white fw-bold">Владелец</th>
                            <th class="text-white fw-bold">Предмет</th>
                            <th class="text-white fw-bold">Лого предмета</th>
                            <th class="text-white fw-bold">Описание</th>
                            <th class="text-white fw-bold">Цена</th>
                            <th class="text-white fw-bold">Действие</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            <tr class="glass-card-hover">
                                @try
                                {
                                    <td class="text-white">@order.Id</td>
                                    <td class="text-white">@Model.Users.FirstOrDefault(u => u.Id == order.OwnerId).UserName</td>
                                    <td class="text-white">@Model.Items.First(g => g.OrderId == order.Id).Name</td>
                                    <td class="text-white"><img src="@Model.Items.First(g => g.OrderId == order.Id).ImgPath" class="img-thumbnail" style="max-height: 60px; background: rgba(255,255,255,0.1);" /></td>
                                    <td class="text-white-50">@Model.Items.First(g => g.OrderId == order.Id).Description</td>
                                    <td class="text-danger fw-bold">@order.BuyPrice.ToString("N0") ₽</td>
                                    if (Model.UserId != 0 && Model.UserId != order.OwnerId)
                                    {
                                        <td>
                                            <form asp-controller="Form" asp-action="BuyOrder" method="post">
                                                <input type="hidden" name="orderId" value="@order.Id" />
                                                <button type="submit" class="btn btn-outline-light">Купить</button>
                                            </form>
                                        </td>
                                    }
                                    else if (Model.UserId == order.OwnerId)
                                    {
                                        <td class="text-danger fw-bold">Ваш ордер</td>
                                    }
                                    else if (Model.UserId == 0)
                                    {
                                        <td class="text-danger fw-bold">Вы не авторизованы</td>
                                    }
                                }
                                catch { }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>